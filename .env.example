# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: написать боту @userinfobot)
OWNER_TELEGRAM_ID=
# Ключ API Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Прокси (если сервер в России): socks5://логин:пароль@адрес:порт
# PROXY_URL используется и для Telegram, и для Claude.
# Отдельно для сервиса: TELEGRAM_PROXY= / ANTHROPIC_PROXY= (значение none отключает прокси)
PROXY_URL=

# --- Почта (шаг 2). Без MAIL_ADDRESS и MAIL_PASSWORD почта выключена ---
MAIL_ADDRESS=
MAIL_PASSWORD=
# Серверы почты reg.ru (менять не нужно)
MAIL_IMAP_HOST=mail.hosting.reg.ru
MAIL_SMTP_HOST=mail.hosting.reg.ru
# Проверять почту раз в сутки в это время (Москва). Пусто — каждые MAIL_CHECK_MINUTES минут
MAIL_CHECK_TIME=07:00
MAIL_CHECK_MINUTES=30
# Папка для спама: пусто — найти автоматически
MAIL_SPAM_FOLDER=
# Переносить в спам письма, которые фильтр сервера пометил в заголовках (да/нет)
MAIL_SPAM_BY_HEADERS=да
# Считать спамом письма, где в X-Spam-Bar не меньше N плюсов (пусто — не учитывать)
MAIL_SPAM_BAR_MIN=
# Сообщать о переносе в спам: количество / список / нет
MAIL_SPAM_NOTIFY=количество

# --- Google Таблица с правилами для писем: ссылка или ID ---
RULES_SHEET_ID=
# Лист с правилами (если его нет, бот создаст)
RULES_SHEET_NAME=Правила для почты
# Ключ сервисного аккаунта Google (скрипт установки копирует его из /opt/moysklad)
GOOGLE_KEY_FILE=/opt/telegram-assistant/google-key.json

# --- Подборка идей по акциям (нужен ключ Anthropic) ---
STOCKS_ENABLED=нет
# Время отправки по будням (Москва)
STOCKS_TIME=08:00
STOCKS_COUNT=5

# Необязательные настройки
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high: глубина размышлений и расход токенов
CLAUDE_EFFORT=medium
# Сколько последних сообщений помнить в диалоге
HISTORY_LIMIT=20
