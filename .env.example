# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: написать боту @userinfobot)
OWNER_TELEGRAM_ID=
# Ключ API Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательные настройки
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high: глубина размышлений и расход токенов
CLAUDE_EFFORT=medium
# Сколько последних сообщений помнить в диалоге
HISTORY_LIMIT=20
