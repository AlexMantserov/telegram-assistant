[Unit]
Description=Telegram assistant bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgbot
WorkingDirectory=/opt/telegram-assistant
ExecStart=/opt/telegram-assistant/.venv/bin/python -m bot.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
